# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Use the FITWINZ Supabase project and Resend account only (not Yousf Dent's).

# Base URL used in email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys (and Data API for the URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable key" (sb_publishable_...) or the legacy "anon public" key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...) or the legacy "service_role" key. SERVER ONLY: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend → API Keys
RESEND_API_KEY=
# Local testing: Resend's test sender (only delivers to your own Resend account email).
# Production (after verifying fitwinz.ma in Resend): Fitwinz <orders@fitwinz.ma>
EMAIL_FROM=Fitwinz <onboarding@resend.dev>
EMAIL_REPLY_TO=fitwinz2@gmail.com
# Where new-order notifications are sent
ORDER_NOTIFICATION_EMAIL=fitwinz2@gmail.com
# Optional: public site used for the logo, product photos and customer links inside emails.
# Defaults to https://fitwinz.ma (mail clients can't load images from localhost).
# EMAIL_SITE_URL=https://fitwinz.ma
