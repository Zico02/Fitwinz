{
  "name": "fitwinz",
  "version": "2.0.0",
  "private": true,
  "description": "Fitwinz storefront (fitwinz.ma): Next.js + Tailwind",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "images:optimize": "node scripts/optimize-images.mjs",
    "test:db": "node supabase/tests/db.test.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mts",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mts",
    "email:previews": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/email-previews.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3"
  }
}
